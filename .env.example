NODE_ENV=development
PORT=3000

# Postgres connection string (Supabase or local Docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public

# JWT access token secret (min 32 chars).
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# JWT access token TTL in seconds.
JWT_ACCESS_TTL_SECONDS=900
