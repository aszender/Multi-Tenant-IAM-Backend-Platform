generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  ORG_ADMIN
  ORG_USER
  READ_ONLY
}

enum AuditAction {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  REFRESH_TOKEN_ROTATED
  LOGOUT
  TENANT_CREATED
  MEMBERSHIP_CREATED
  MEMBERSHIP_REMOVED
  ROLE_CHANGED
  PERMISSION_CHANGED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  AUTHORIZATION_DENIED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  projects    Project[]
  roles       Role[]
  auditEvents AuditEvent[]
  refreshTokens RefreshToken[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Text
  passwordHash String   @map("password_hash") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  createdProjects Project[] @relation("projects_created_by")
  refreshTokens RefreshToken[]
  auditEvents AuditEvent[] @relation("audit_events_actor")

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  roleId         String?          @map("role_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef      Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId], map: "organization_memberships_org_user_unique")
  @@index([userId], map: "organization_memberships_user_id_idx")
  @@index([organizationId, role], map: "organization_memberships_org_role_idx")
  @@map("organization_memberships")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  key            OrganizationRole
  name           String           @db.Text
  description    String?          @db.Text
  isSystem       Boolean          @default(true) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]
  permissions  RolePermission[]

  @@unique([organizationId, key], map: "roles_org_key_unique")
  @@index([organizationId], map: "roles_org_id_idx")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @map("token_hash") @db.Text
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String? @map("replaced_by_token_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId], map: "refresh_tokens_user_org_idx")
  @@index([tokenHash], map: "refresh_tokens_token_hash_idx")
  @@map("refresh_tokens")
}

model AuditEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  action         AuditAction
  resourceType   String?     @map("resource_type") @db.Text
  resourceId     String?     @map("resource_id") @db.Text
  ipAddress      String?     @map("ip_address") @db.Text
  userAgent      String?     @map("user_agent") @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor       User?          @relation("audit_events_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], map: "audit_events_org_created_at_idx")
  @@index([actorUserId, createdAt], map: "audit_events_actor_created_at_idx")
  @@index([action, createdAt], map: "audit_events_action_created_at_idx")
  @@map("audit_events")
}

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.Text
  description     String?  @db.Text
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("projects_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, id], map: "projects_org_id_id_idx")
  @@index([organizationId, createdAt], map: "projects_org_created_at_idx")
  @@unique([organizationId, name], map: "projects_org_name_unique")
  @@map("projects")
}
