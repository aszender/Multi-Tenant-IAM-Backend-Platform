{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "modulePathIgnorePatterns": ["<rootDir>/.claude/", "<rootDir>/dist/"],
  "testPathIgnorePatterns": ["<rootDir>/.claude/", "<rootDir>/dist/"],
  "testEnvironment": "node"
}
